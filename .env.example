# --- Browser app (build time) ---
# Where the AI backend lives. Same-origin on Vercel: /api/ai. From GitHub Pages: the full https URL of your Vercel deployment.
VITE_AI_ENDPOINT=/api/ai

# --- Server (Vercel project environment variables, NEVER VITE_*) ---
# FREE option: Google Gemini. Key from https://aistudio.google.com/apikey (no billing needed, rate-limited).
GEMINI_API_KEY=
# Paid option: Claude. Used only if GEMINI_API_KEY is empty.
# ANTHROPIC_API_KEY=
# AI_MODEL_PATIENT=gemini-2.5-flash-lite
# AI_MODEL_DEBRIEF=gemini-2.5-flash-lite
# Only needed if the app is served from a different domain than the API, e.g. https://3lim3hmoud.github.io
# ALLOWED_ORIGINS=https://3lim3hmoud.github.io
